<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DeadworksManaged.Api">
      <HintPath>$(DeadworksLibDir)/DeadworksManaged.Api.dll</HintPath>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>$(DeadworksLibDir)/Google.Protobuf.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\CrystalCrackers\Pit\PitRoundRule.cs" Link="CrystalCrackers\Pit\PitRoundRule.cs" />
    <Compile Include="..\..\CrystalCrackers\Pit\PitLocations.cs" Link="CrystalCrackers\Pit\PitLocations.cs" />
    <Compile Include="..\..\CrystalCrackers\Pit\PitSpots.cs" Link="CrystalCrackers\Pit\PitSpots.cs" />
    <EmbeddedResource Include="..\..\CrystalCrackers\Pit\Data\spots.json" LogicalName="CrystalCrackers.Pit.spots.json" Link="CrystalCrackers\Pit\Data\spots.json" />
  </ItemGroup>

  <Import Project="..\..\Shared\Shared.projitems" />
  <Import Project="..\..\Modules\Movement\Movement.projitems" />

</Project>
