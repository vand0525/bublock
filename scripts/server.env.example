# Copy to scripts/server.env (git-ignored) and fill in your server's SFTP details.
# The password comes from scripts/sftp-password.sh: DW_PASSWORD below, else the
# macOS keychain / Linux keyring (service deadworks-sftp, account DW_USER).
DW_HOST="your.server.ip"
DW_PORT="22"
DW_USER="your-sftp-user"
# Optional: the in-game connect address, for your own reference.
# DW_GAME_ADDR="your.server.ip:27015"
# Optional: plain-file password (keep this file chmod 600).
# DW_PASSWORD=""
# Optional: remote game folder over SFTP (default /server/game; "" = SFTP root).
# DW_REMOTE_GAME=""
